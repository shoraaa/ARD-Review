# Copy to .env if needed. Direct CLI runs require no API credentials:
# python code/main.py --backend codex --single_paper paper.md --no_cal
# python code/main.py --backend claude --single_paper paper.md --no_cal
# CLI authentication is managed by the installed codex/claude command.

# Optional mixed-backend selection instead of --backend (CLI default models):
# HARSH_MODEL=codex
# MERGER_MODEL=claude
# Use codex:MODEL or claude:MODEL to pin models. Existing plain API model IDs
# and claude_sdk:MODEL are still supported.
# REASONING_EFFORT=high
# EXTRACTOR_MODEL=your-api-extractor-model  # optional fallback for SDK/API only

# CLI settings (optional). Paths name a single executable, not a shell command.
# CODEX_CLI_PATH=/path/to/codex
# CLAUDE_CLI_PATH=/path/to/claude
# REVIEW_CLI_TIMEOUT=1800
# REVIEW_CALIBRATION_MODE=bm25  # CLI default; SDK/API default is vector

# ── Endpoint for the OpenAI Agents SDK path ──
# Default endpoint is OpenRouter; point REVIEW_API_BASE_URL anywhere
# OpenAI-compatible (https://api.openai.com/v1, a vLLM server, ...).
REVIEW_API_KEY=
REVIEW_API_BASE_URL=https://openrouter.ai/api/v1

# ── Embedding endpoint (independent of reviewer authentication) ──
# Leave these empty to reuse REVIEW_API_BASE_URL / REVIEW_API_KEY.
# A different endpoint requires its own key; reviewer keys are never forwarded
# automatically to a different embedding provider.
REVIEW_EMBEDDING_BASE_URL=
REVIEW_EMBEDDING_API_KEY=
# Must match the model used to build the published embedding matrix.
REVIEW_EMBEDDING_MODEL=google/gemini-embedding-001

# For a direct Gemini API key, replace the three embedding values above with:
# REVIEW_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# REVIEW_EMBEDDING_API_KEY=your-gemini-api-key
# REVIEW_EMBEDDING_MODEL=gemini-embedding-001
# Then use --calibration_mode vector with either --backend codex or --backend claude.

# Optional, OpenRouter only: pin the upstream provider so a run cannot silently
# switch backends mid-way. Leave empty for any other endpoint.
OPENROUTER_PROVIDER=

# ── Claude Agent SDK path ──
# Set to an Anthropic API key, or leave empty to use an authenticated
# Claude subscription (claude setup-token / claude login).
ANTHROPIC_API_KEY=

# ── Datalab PDF parsing (SDK/API default, or --pdf_parser datalab) ──
# CLI runs use local pdftotext by default; no key is needed.
DATALAB_API_KEY=
